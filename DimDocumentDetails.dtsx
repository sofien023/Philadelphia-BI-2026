      DTS:CreationName=""
      DTS:DTSID="{B6964290-E457-4271-A40B-8CD004C6A7F3}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT&#xA;    dd.DocD_Id,&#xA;    dd.Doc_Num,&#xA;    dd.Art_Code,&#xA;    dd.DocD_Q,&#xA;    dd.DocD_PUHTB&#xA;FROM TESTPH2.dbo.DocumentD dd&#xA;JOIN TESTPH2.dbo.Document d&#xA;    ON d.Doc_Num = dd.Doc_Num&#xA; WHERE d.Doc_Type IN ('Fact', 'AVOI')&#xA;  AND d.Doc_Valide = 2&#xA;  AND dd.Art_Code &lt;&gt; 'ANNULER'&#xA;  AND d.Doc_Date &gt;= '&quot; +&#xA;(DT_STR, 10, 1252)(DT_DBDATE) @[User::LastRunDate]&#xA;+ &quot;'&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SourceQuery">
      <DTS:VariableValue
        DTS:DataType="8">SELECT
    dd.DocD_Id,
    dd.Doc_Num,
    dd.Art_Code,
    dd.DocD_Q,
    dd.DocD_PUHTB
FROM TESTPH2.dbo.DocumentD dd
JOIN TESTPH2.dbo.Document d
    ON d.Doc_Num = dd.Doc_Num
 WHERE d.Doc_Type IN ('Fact', 'AVOI')
  AND d.Doc_Valide = 2
  AND dd.Art_Code &lt;&gt; 'ANNULER'
  AND d.Doc_Date &gt;= '2000-01-01'</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
